; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beyond the Nebula"
run/main_scene="uid://bacsaihbvq5bw"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://blwqw8c5ug00d"

[autoload]

Global="*uid://b243667avyug2"
GUIDE="*uid://p2jwrgjcbexr"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot_Super-Wakatime/plugin.cfg", "res://addons/guide/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

